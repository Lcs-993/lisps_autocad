<MenuGroup xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Name="LISPS" DisplayName="Lisps AutoCAD">
  <MacroGroup Name="LISPSMacros" Citizen="A">
    <MenuMacro UID="MM_LISPS_TRLE">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_TRLE_N">Transformar em Limite Externo</Name>
        <Command>^C^CTR-LE</Command>
        <HelpString xlate="true" UID="XLS_LISPS_TRLE_H">Troca rapidamente o layer dos objetos selecionados para o de limite externo (LIMITE_EXTERNO)</HelpString>
        <SmallImage Name="RCDATA_16_LAYCUR" />
        <LargeImage Name="RCDATA_32_LAYCUR" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_CRIALINHAS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_CL_N">Criar Linhas</Name>
        <Command>^C^CCRIALINHAS</Command>
        <HelpString xlate="true" UID="XLS_LISPS_CL_H">Cria linhas guias, de plantio e de cabeceira (sulcação, plantio e colheita) dentro dos talhões</HelpString>
        <SmallImage Name="RCDATA_16_OFFSET" />
        <LargeImage Name="RCDATA_32_OFFSET" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_CONECTALINHAS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_CN_N">Conectar Linhas</Name>
        <Command>^C^CCONECTALINHAS</Command>
        <HelpString xlate="true" UID="XLS_LISPS_CN_H">Conecta as linhas da mesma fileira em talhões vizinhos (através dos carreadores) numa polilinha contínua, para reduzir manobras. Equivalente ao GOCON do AgroCAD</HelpString>
        <SmallImage Name="RCDATA_16_JOIN" />
        <LargeImage Name="RCDATA_32_JOIN" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_CARREADORES">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_CR_N">Carreadores</Name>
        <Command>^C^CCARREADORES</Command>
        <HelpString xlate="true" UID="XLS_LISPS_CR_H">Corta os talhões por faixas de carreador em volta dos eixos e desenha os carreadores; Juntar Talhões desfaz carreadores. Equivalente ao GOROA do AgroCAD</HelpString>
        <SmallImage Name="RCDATA_16_SUBTRACT" />
        <LargeImage Name="RCDATA_32_SUBTRACT" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_SISCOORD">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_SC_N">Coordenadas e Unidades</Name>
        <Command>^C^CSISCOORD</Command>
        <HelpString xlate="true" UID="XLS_LISPS_SC_H">Configura o sistema de coordenadas do projeto atual (Sirgas 2000, WGS84, SAD69, Córrego Alegre) e as unidades do projeto. Equivalente ao CSYS do AgroCAD</HelpString>
        <SmallImage Name="RCDATA_16_UCS" />
        <LargeImage Name="RCDATA_32_UCS" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_DESVIAOBS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_OB_N">Desviar Obstáculos</Name>
        <Command>^C^CDESVIAOBS</Command>
        <HelpString xlate="true" UID="XLS_LISPS_OB_H">Desvia as linhas que cruzam obstáculos (contornos aninhados, raio mínimo e afastamento) ou apenas as interrompe. Equivalente ao GOOBS do AgroCAD</HelpString>
        <SmallImage Name="RCDATA_16_BREAK" />
        <LargeImage Name="RCDATA_32_BREAK" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_MANOBRAS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_MN_N">Manobras</Name>
        <Command>^C^CMANOBRAS</Command>
        <HelpString xlate="true" UID="XLS_LISPS_MN_H">Cria manobras em U ou ômega pelo raio de giro (a cada N, caracol ou 1-3-5-2-4), corta as linhas pelo afastamento da bordadura e junta os trajetos. Equivalente ao GOTUR do AgroCAD</HelpString>
        <SmallImage Name="RCDATA_16_FILLET" />
        <LargeImage Name="RCDATA_32_FILLET" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_SIS_CONCORDAR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_SCC_N">Concordar Eixos</Name>
        <Command>^C^CSIS_CONCORDAR</Command>
        <HelpString xlate="true" UID="XLS_LISPS_SCC_H">Concordância de eixos de estradas: arcos de raio R nos cruzamentos (T, X, L) com quebra no nó, ou praça em volta de ilhas/obstáculos com bifurcação e fusão e quebra nas tangências</HelpString>
        <SmallImage Name="RCDATA_16_FILLET" />
        <LargeImage Name="RCDATA_32_FILLET" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_TRLI">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_TRLI_N">Transformar em Limite Interno</Name>
        <Command>^C^CTR-LI</Command>
        <HelpString xlate="true" UID="XLS_LISPS_TRLI_H">Troca rapidamente o layer dos objetos selecionados para o de limite interno (LIMITE_INTERNO)</HelpString>
        <SmallImage Name="RCDATA_16_LAYCUR" />
        <LargeImage Name="RCDATA_32_LAYCUR" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_TRSU">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_TRSU_N">Transformar em Sulcação</Name>
        <Command>^C^CTR-SU</Command>
        <HelpString xlate="true" UID="XLS_LISPS_TRSU_H">Troca rapidamente o layer dos objetos selecionados para o de sulcação (SULCOS MESTRES)</HelpString>
        <SmallImage Name="RCDATA_16_LAYCUR" />
        <LargeImage Name="RCDATA_32_LAYCUR" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_TRTA">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_TRTA_N">Transformar em Talhão</Name>
        <Command>^C^CTR-TA</Command>
        <HelpString xlate="true" UID="XLS_LISPS_TRTA_H">Troca rapidamente o layer dos objetos selecionados para o de talhão (TALHÕES)</HelpString>
        <SmallImage Name="RCDATA_16_LAYCUR" />
        <LargeImage Name="RCDATA_32_LAYCUR" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_TRTE">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_TRTE_N">Transformar em Terraço</Name>
        <Command>^C^CTR-TE</Command>
        <HelpString xlate="true" UID="XLS_LISPS_TRTE_H">Troca rapidamente o layer dos objetos selecionados para o de terraço (TERRAÇOS)</HelpString>
        <SmallImage Name="RCDATA_16_LAYCUR" />
        <LargeImage Name="RCDATA_32_LAYCUR" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_TRCO">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_TRCO_N">Transformar em Colheita</Name>
        <Command>^C^CTR-CO</Command>
        <HelpString xlate="true" UID="XLS_LISPS_TRCO_H">Troca rapidamente o layer dos objetos selecionados para o de colheita (LINHAS DE CANA)</HelpString>
        <SmallImage Name="RCDATA_16_LAYCUR" />
        <LargeImage Name="RCDATA_32_LAYCUR" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_CORTALIM">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_CORTALIM_N">Cortar linhas pelo limite do talhão</Name>
        <Command>^C^CCORTALIM</Command>
        <HelpString xlate="true" UID="XLS_LISPS_CORTALIM_H">Corta os trechos das linhas que ultrapassam os limites dos talhões selecionados, mantendo as propriedades das linhas originais</HelpString>
        <SmallImage Name="RCDATA_16_TRIM" />
        <LargeImage Name="RCDATA_32_TRIM" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_ESTENDELIM">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_ESTENDELIM_N">Estender linhas até o limite do talhão</Name>
        <Command>^C^CESTENDELIM</Command>
        <HelpString xlate="true" UID="XLS_LISPS_ESTENDELIM_H">Estende as pontas das linhas selecionadas, pela tangente, até o limite do talhão que as contém</HelpString>
        <SmallImage Name="RCDATA_16_EXTEND" />
        <LargeImage Name="RCDATA_32_EXTEND" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_AJUSTALIM">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_AJUSTALIM_N">Estender e cortar linhas até o limite do talhão</Name>
        <Command>^C^CAJUSTALIM</Command>
        <HelpString xlate="true" UID="XLS_LISPS_AJUSTALIM_H">Estende as pontas que estão dentro do talhão e corta os trechos que ultrapassam o limite</HelpString>
        <SmallImage Name="RCDATA_16_EXTEND" />
        <LargeImage Name="RCDATA_32_EXTEND" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_APAGALIM">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_APAGALIM_N">Apagar objetos dentro ou fora de limite</Name>
        <Command>^C^CAPAGALIM</Command>
        <HelpString xlate="true" UID="XLS_LISPS_APAGALIM_H">Apaga objetos inteira ou parcialmente contidos (ou fora de) uma polilinha fechada, independente do zoom</HelpString>
        <SmallImage Name="RCDATA_16_ERASE" />
        <LargeImage Name="RCDATA_32_ERASE" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_RA_VALIDAR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_RAV_N">Validar Rede de Rotas</Name>
        <Command>^C^CREDE_VALIDAR</Command>
        <HelpString xlate="true" UID="XLS_LISPS_RAV_H">Valida a geometria da rede de rotas (só leitura): cruzamentos e T sem vértice, pontas soltas, vértices quase coincidentes, duplicados, objetos não suportados, coordenadas e componentes; marca no layer REDE_ERROS e gera CSV</HelpString>
        <SmallImage Name="RCDATA_16_JOIN" />
        <LargeImage Name="RCDATA_32_JOIN" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_RA_CORRIGIR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_RAC_N">Corrigir Rede de Rotas</Name>
        <Command>^C^CREDE_CORRIGIR</Command>
        <HelpString xlate="true" UID="XLS_LISPS_RAC_H">Corrige a topologia da rede (modo simulação ou UNDO único): insere vértices em cruzamentos e T, fecha pontas soltas, une vértices, remove duplicados e segmentos zero, converte arcos e curvas; gera log CSV</HelpString>
        <SmallImage Name="RCDATA_16_BREAK" />
        <LargeImage Name="RCDATA_32_BREAK" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_RA_PROXIMO">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_RAP_N">Próximo Erro da Rede</Name>
        <Command>^C^CREDE_PROXIMO</Command>
        <HelpString xlate="true" UID="XLS_LISPS_RAP_H">Vai até o próximo marcador de erro do REDE_VALIDAR (zoom, descrição e seleção das linhas envolvidas)</HelpString>
        <SmallImage Name="RCDATA_16_JOIN" />
        <LargeImage Name="RCDATA_32_JOIN" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_RA_EXPORTAR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_RAE_N">Exportar Rede (GeoJSON)</Name>
        <Command>^C^CREDE_EXPORTAR</Command>
        <HelpString xlate="true" UID="XLS_LISPS_RAE_H">Exporta as linhas da rede em GeoJSON com o membro crs do EPSG (arcos viram vértices), pronto para o Routes Analyzer</HelpString>
        <SmallImage Name="RCDATA_16_JOIN" />
        <LargeImage Name="RCDATA_32_JOIN" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_ALT_REDECARREGARA">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_ALT_REDECARREGARA_N">Carregar versão RA_REDE</Name>
        <Command>^C^CREDE_CARREGA_RA</Command>
        <HelpString xlate="true" UID="XLS_LISPS_ALT_REDECARREGARA_H">Carrega (ou recarrega) routes_analyzer\tools\autocad\RA_REDE.lsp, a outra versão da ferramenta de rede, para comparação</HelpString>
        <SmallImage Name="RCDATA_16_JOIN" />
        <LargeImage Name="RCDATA_32_JOIN" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_ALT_RAVERIFICAR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_ALT_RAVERIFICAR_N">RA_REDE: Verificar</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_VERIFICAR))</Command>
        <HelpString xlate="true" UID="XLS_LISPS_ALT_RAVERIFICAR_H">RA_REDE.lsp: verifica a rede e marca os problemas no layer RA_ERROS (não altera as linhas)</HelpString>
        <SmallImage Name="RCDATA_16_JOIN" />
        <LargeImage Name="RCDATA_32_JOIN" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_ALT_RACORRIGIR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_ALT_RACORRIGIR_N">RA_REDE: Corrigir Tudo</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_CORRIGIR))</Command>
        <HelpString xlate="true" UID="XLS_LISPS_ALT_RACORRIGIR_H">RA_REDE.lsp: apaga duplicadas, liga pontas soltas, quebra nos entroncamentos, emenda pseudo-nós e verifica de novo</HelpString>
        <SmallImage Name="RCDATA_16_BREAK" />
        <LargeImage Name="RCDATA_32_BREAK" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_ALT_RAQUEBRAR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_ALT_RAQUEBRAR_N">RA_REDE: Quebrar nos Entroncamentos</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_QUEBRAR))</Command>
        <HelpString xlate="true" UID="XLS_LISPS_ALT_RAQUEBRAR_H">RA_REDE.lsp: quebra as linhas em todos os entroncamentos e cruzamentos</HelpString>
        <SmallImage Name="RCDATA_16_BREAK" />
        <LargeImage Name="RCDATA_32_BREAK" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_ALT_RAPONTAS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_ALT_RAPONTAS_N">RA_REDE: Ligar Pontas Soltas</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_PONTAS))</Command>
        <HelpString xlate="true" UID="XLS_LISPS_ALT_RAPONTAS_H">RA_REDE.lsp: leva cada ponta solta até a linha ou vértice mais próximo e quebra</HelpString>
        <SmallImage Name="RCDATA_16_EXTEND" />
        <LargeImage Name="RCDATA_32_EXTEND" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_ALT_RAJUNTAR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
