        <Name xlate="true" UID="XLS_LISPS_ALT_RALIMPAR_N">RA_REDE: Limpar Marcadores</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_LIMPAR))</Command>
        <HelpString xlate="true" UID="XLS_LISPS_ALT_RALIMPAR_H">RA_REDE.lsp: apaga os marcadores</HelpString>
        <SmallImage Name="RCDATA_16_ERASE" />
        <LargeImage Name="RCDATA_32_ERASE" />
