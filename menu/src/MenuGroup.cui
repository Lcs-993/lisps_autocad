        <SmallImage Name="ft-ra-limpar-16.png" />
        <LargeImage Name="ft-ra-limpar-32.png" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_FT_ALT_RADESENHAR">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_FT_ALT_RADESENHAR_N">Rede de Rotas: Desenhar Linha da Rede</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_DESENHAR))</Command>
        <HelpString xlate="true" UID="XLS_FT_ALT_RADESENHAR_H">RA_REDE.lsp: desenha uma linha da rede e quebra as que ela toca</HelpString>
        <SmallImage Name="ft-ra-desenhar-16.png" />
        <LargeImage Name="ft-ra-desenhar-32.png" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_FT_ALT_RACONFIG">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_FT_ALT_RACONFIG_N">Rede de Rotas: Configurar</Name>
        <Command>^C^CREDE_CONFIG</Command>
        <HelpString xlate="true" UID="XLS_FT_ALT_RACONFIG_H">Abre o diálogo de configuração da Rede de Rotas: camadas da rede, de desenho e de mão única, tolerâncias e marcadores (grava para todos os desenhos)</HelpString>
        <SmallImage Name="ft-ra-config-16.png" />
        <LargeImage Name="ft-ra-config-32.png" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_FT_ALT_RAAJUDA">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_FT_ALT_RAAJUDA_N">Rede de Rotas: Ajuda</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_AJUDA))</Command>
        <HelpString xlate="true" UID="XLS_FT_ALT_RAAJUDA_H">RA_REDE.lsp: lista os comandos</HelpString>
        <SmallImage Name="ft-ra-ajuda-16.png" />
        <LargeImage Name="ft-ra-ajuda-32.png" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_FT_SIMPLIFICAPL">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_FT_SMP_N">Simplificar Polilinhas</Name>
        <Command>^C^CSIMPLIFICAPL</Command>
        <HelpString xlate="true" UID="XLS_FT_SMP_H">Reduz a quantidade de vértices de polilinhas sem que a curva se afaste mais que a tolerância de desvio (Douglas-Peucker); arcos e pontas são preservados</HelpString>
        <SmallImage Name="ft-simplificapl-16.png" />
        <LargeImage Name="ft-simplificapl-32.png" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_FT_SEGMENTARCOS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_FT_SEGA_N">Segmentar Arcos</Name>
        <Command>^C^CSEGMENTARCOS</Command>
        <HelpString xlate="true" UID="XLS_FT_SEGA_H">Converte os arcos das polilinhas (e, opcionalmente, arcos e círculos avulsos) em segmentos de reta, por desvio máximo (flecha) ou medida fixa</HelpString>
        <SmallImage Name="ft-segmentarcos-16.png" />
        <LargeImage Name="ft-segmentarcos-32.png" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_FT_REMOVENOS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_FT_RN_N">Remover Nós</Name>
        <Command>^C^CREMOVENOS</Command>
        <HelpString xlate="true" UID="XLS_FT_RN_H">Remove os nós (auto-cruzamentos e espinhos) das polilinhas selecionadas: o laço sai e fica um vértice no cruzamento. Equivalente ao RNOS do AgroCAD</HelpString>
        <SmallImage Name="ft-removenos-16.png" />
        <LargeImage Name="ft-removenos-32.png" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_FT_PADRONIZAVERT">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_FT_PV_N">Padronizar Vértices</Name>
        <Command>^C^CPADRONIZAVERT</Command>
        <HelpString xlate="true" UID="XLS_FT_PV_H">Padroniza o espaçamento entre os vértices ao longo das polilinhas selecionadas, preservando os cantos. Equivalente ao HME do AgroCAD</HelpString>
        <SmallImage Name="ft-padronizavert-16.png" />
        <LargeImage Name="ft-padronizavert-32.png" />
      </Macro>
    </MenuMacro>
  </MacroGroup>
</MenuGroup>
