<MenuGroup xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Name="LISPS" DisplayName="Lisps AutoCAD">
  <MacroGroup Name="LISPSMacros" Citizen="A">
    <MenuMacro UID="MM_LISPS_TRLE">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_TRLE_N">Transformar em Limite Externo</Name>
        <Command>^C^CTR-LE</Command>
        <HelpString xlate="true" UID="XLS_LISPS_TRLE_H">Troca rapidamente o layer dos objetos selecionados para o de limite externo (LIMITE_EXTERNO)</HelpString>
        <SmallImage Name="RCDATA_16_LAYCUR" />
        <LargeImage Name="RCDATA_32_LAYCUR" />
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_LISPS_CRIALINHAS">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0" />
        <ModifiedRev MajorVersion="23" MinorVersion="0" UserVersion="0" />
        <Name xlate="true" UID="XLS_LISPS_CL_N">Criar Linhas</Name>
        <Command>^C^CCRIALINHAS</Command>
        <HelpString xlate="true" UID="XLS_LISPS_CL_H">Cria linhas guias, de plantio e de cabeceira (sulcação, plantio e colheita) dentro dos talhões</HelpString>
        <SmallImage Name="RCDATA_16_OFFSET" />
        <LargeImage Name="RCDATA_32_OFFSET" />
      </Macro>
    </MenuMacro>
  </MacroGroup>
</MenuGroup>
