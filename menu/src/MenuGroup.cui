        <Name xlate="true" UID="XLS_FT_ALT_RAPROXIMO_N">Rede de Rotas: Próximo Marcador</Name>
        <Command>^C^C(if (rr:carrega-ra nil) (c:RA_PROXIMO))</Command>
        <HelpString xlate="true" UID="XLS_FT_ALT_RAPROXIMO_H">RA_REDE.lsp: zoom no próximo marcador</HelpString>
        <SmallImage Name="ft-rede-proximo-16.png" />
        <LargeImage Name="ft-rede-proximo-32.png" />
      </Macro>
    </MenuMacro>
